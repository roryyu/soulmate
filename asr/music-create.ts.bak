import * as fs from 'fs';
import * as path from 'path';
const ffmpeg = require('fluent-ffmpeg');
const ffmpegStatic = require('ffmpeg-static');
const ffprobeStatic = require('ffprobe-static');

// 设置ffmpeg路径
ffmpeg.setFfmpegPath(ffmpegStatic);
ffmpeg.setFfprobePath(ffprobeStatic.path);

interface MusicDuration {
  fileName: string;
  duration: number; // 秒
}

// 使用process.cwd()获取当前工作目录
const projectRoot = process.cwd();
const musicDir = path.join(projectRoot, 'music');

console.log('项目根目录:', projectRoot);
console.log('音乐目录:', musicDir);
console.log('音乐目录是否存在:', fs.existsSync(musicDir));

if (fs.existsSync(musicDir)) {
  console.log('音乐目录中的文件:', fs.readdirSync(musicDir));
}

async function getAudioDuration(filePath: string): Promise<number> {
  return new Promise((resolve, reject) => {
    ffmpeg.ffprobe(filePath, (err: any, metadata: any) => {
      if (err) {
        reject(err);
      } else {
        resolve(metadata.format.duration || 0);
      }
    });
  });
}

async function getMusicDurations(): Promise<MusicDuration[]> {
  try {
    const files = fs.readdirSync(musicDir);
    const wavFiles = files.filter(file => file.endsWith('.wav'));
    
    console.log('找到的WAV文件:', wavFiles);
    
    const durations: MusicDuration[] = [];
    
    for (const file of wavFiles) {
      const filePath = path.join(musicDir, file);
      console.log(`正在处理文件: ${file}`);
      const duration = await getAudioDuration(filePath);
      durations.push({
        fileName: file,
        duration: duration
      });
      console.log(`文件 ${file} 时长: ${duration} 秒`);
    }
    
    return durations;
  } catch (error) {
    console.error('获取音乐时长时出错:', error);
    throw error;
  }
}

// 如果直接运行此脚本
if (require.main === module) {
  getMusicDurations()
    .then(durations => {
      const outputPath = path.join(projectRoot, 'lib/music-durations.json');
      fs.writeFileSync(outputPath, JSON.stringify(durations, null, 2));
      console.log(`音乐时长数据已保存到: ${outputPath}`);
      console.log('结果:', JSON.stringify(durations, null, 2));
    })
    .catch(error => {
      console.error('处理失败:', error);
      process.exit(1);
    });
}

export { getMusicDurations, MusicDuration };
